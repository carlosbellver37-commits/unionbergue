---
// Fuentes alojadas en la propia web (antes Google Fonts: evita enviar la IP de cada
// visitante a Google y una conexión externa). Solo el subconjunto latino, salvo Fraunces,
// cuyos otros subconjuntos solo se descargan si se usan sus caracteres.
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/allura/latin-400.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import frauncesPortada from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import cormorantPortada from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-300-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Cabecera en color claro mientras está sobre un hero oscuro. */
  cabeceraClara?: boolean;
  sinLogo?: boolean;
  /** Páginas que no deben aparecer en buscadores (p. ej. la 404). */
  noindex?: boolean;
}

const { title, description = site.descripcion, cabeceraClara = false, sinLogo = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.nombre}` : `${site.nombre} · ${site.lema}`;
// Sin "site" configurado (p. ej. servidor arrancado antes de definirlo) se usa la URL de la petición
const origen = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, origen);
const ogImage = new URL('/og.jpg', origen);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6eee0" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Las dos fuentes de la portada, sin esperar a descubrirlas en el CSS -->
    <link rel="preload" href={frauncesPortada} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={cormorantPortada} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('motion');
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Header clara={cabeceraClara} sinLogo={sinLogo} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style>
  .saltar {
    position: fixed; top: 0.5rem; left: 0.5rem; z-index: 200;
    padding: 0.6rem 1rem; background: var(--corteza); color: var(--harina);
    transform: translateY(-200%);
  }
  .saltar:focus { transform: none; }
</style>

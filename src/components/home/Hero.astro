---
/**
 * Portada: "Bergue" arriba, con "Las Tablas" en caligrafía dorada debajo a la
 * derecha, y en una fila, "Panadería" · taza · "Pastelería".
 * Dos líneas finas terracota, simétricas respecto al centro de la taza: una
 * por debajo de las palabras, que rodea la taza por abajo (bajo "Cafetería"),
 * y su reflejo por encima, que pasa por detrás de "Bergue". Las curvas entran
 * suavemente (empalme circular). La geometría se calcula en JS.
 */
import TituloMarca from '../ui/TituloMarca.astro';
---

<section class="hero" aria-labelledby="hero-titulo" data-hero>
  <div class="hero__cabecera">
    <TituloMarca texto="Bergue" id="hero-titulo" etiqueta="Pastelería Bergue Las Tablas" class="hero__marca" />
    <p class="hero__sede" aria-hidden="true">Las Tablas</p>
  </div>
  <p class="sr-only">Panadería, cafetería y pastelería</p>

  <div class="hero__fila" data-fila>
    <svg class="hero__trazo" aria-hidden="true" data-trazo>
      <path class="hero__linea" data-linea="abajo" pathLength="1000" />
      <path class="hero__linea" data-linea="arriba" pathLength="1000" />
      <path id="arco-cafeteria" fill="none" data-arco />
      <!-- Solo para medir: Safari da longitud 0 a un textPath sin trazado -->
      <text class="hero__cafeteria" visibility="hidden" data-cafeteria-medida>Cafetería</text>
      <text class="hero__cafeteria" dominant-baseline="middle" data-cafeteria>
        <textPath href="#arco-cafeteria" startOffset="50%" text-anchor="middle">Cafetería</textPath>
      </text>
    </svg>

    <p class="hero__palabra hero__palabra--izq" aria-hidden="true" data-palabra="izq">Panadería</p>

    <div class="hero__taza" aria-hidden="true" data-taza>
      <img class="hero__taza-sombra" src="/img/portada/taza.webp" alt="" width="900" height="837" data-taza-sombra />
      <img class="hero__taza-img" src="/img/portada/taza.webp" alt="" width="900" height="837" fetchpriority="high" data-taza-img />
    </div>

    <p class="hero__palabra hero__palabra--der" aria-hidden="true" data-palabra="der">Pastelería</p>
  </div>

  <a href="#conocenos" class="hero__bajar" aria-label="Bajar a Conócenos" data-bajar>
    <svg viewBox="0 0 28 14" aria-hidden="true"><path d="M2 2l12 10L26 2" /></svg>
  </a>
</section>

<style>
  .hero {
    --cafe: #3a241c;
    --terracota: #964b36;
    --oro: #a8813f;
    --taza: min(36vmin, 25rem);
    position: relative;
    height: 100svh;
    min-height: 34rem;
    display: grid;
    grid-template-rows: auto 1fr;
    grid-template-columns: 100%;
    background: #f4eee0;
    overflow: hidden;
  }

  .hero__cabecera {
    /* Mismo tamaño que el título (TituloMarca, 6 letras) para escalar "Las Tablas" con él */
    --titulo: clamp(4rem, 21vw, min(21rem, 32svh));
    position: relative;
    z-index: 2;
    justify-self: center;
    margin-top: -0.6rem;
  }

  /* "Las Tablas": caligrafía fina en dorado, bajo el final de "Bergue" (a la derecha
     del rabo de la g). Fuera del flujo para no mover la fila de la taza. */
  .hero__sede {
    position: absolute;
    right: 0;
    top: calc(100% - 0.32em);
    padding: 0 0.12em;
    font-family: 'Allura', 'Brush Script MT', cursive;
    font-weight: 400;
    font-size: calc(var(--titulo) * 0.18);
    line-height: 1;
    color: var(--oro);
    white-space: nowrap;
    background: #f4eee0; /* la línea fina pasa por detrás, como con "Bergue" */
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.motion) .hero__sede { animation: sede 1.4s var(--ease-out) 0.5s both; }
  }
  @keyframes sede {
    from { opacity: 0; clip-path: inset(0 100% 0 0); }
    to { opacity: 1; clip-path: inset(0 0 0 0); }
  }

  /* Palabra · taza · palabra; el hueco lateral lo fija el script según el arco */
  .hero__fila {
    position: relative;
    align-self: start;
    margin-top: clamp(1.8rem, 8svh, 4.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--taza) minmax(0, 1fr);
    align-items: center;
    column-gap: var(--hueco, 3rem);
  }

  .hero__trazo {
    position: absolute;
    left: 0;
    top: 0;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .hero__linea { fill: none; stroke: var(--terracota); stroke-width: 1.2; stroke-linecap: round; }
  .hero__cafeteria {
    font-family: 'Cormorant Garamond', 'Garamond', serif;
    font-weight: 300;
    letter-spacing: 0.06em;
    fill: var(--cafe);
  }

  .hero__palabra {
    position: relative;
    z-index: 1;
    font-family: 'Cormorant Garamond', 'Garamond', serif;
    font-weight: 300;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--cafe);
    white-space: nowrap;
    font-size: clamp(2.5rem, 9vw, 11rem);
  }
  .hero__palabra--izq { justify-self: start; }
  .hero__palabra--der { justify-self: end; }

  .hero__taza { position: relative; z-index: 1; aspect-ratio: 900 / 837; }
  .hero__taza > img { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__taza-sombra {
    filter: brightness(0) blur(18px);
    opacity: 0.28;
    transform: translate(18px, 26px) scale(0.97);
    will-change: transform;
  }
  .hero__taza-img { will-change: transform; }

  /* Hasta que arranque la animación no se ve nada de la fila (evita parpadeos) */
  :global(.motion) .hero__taza,
  :global(.motion) .hero__palabra,
  :global(.motion) .hero__trazo { opacity: 0; }

  /* Flecha "⌄" para bajar */
  .hero__bajar {
    position: absolute;
    left: 50%;
    bottom: clamp(1rem, 3svh, 2.2rem);
    translate: -50% 0;
    padding: 0.8rem;
    color: var(--cafe);
  }
  .hero__bajar svg {
    display: block;
    width: 1.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: bajar 2.4s ease-in-out infinite;
  }
  .hero__bajar:hover svg { animation-duration: 1.1s; }
  @keyframes bajar {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(6px); opacity: 1; }
  }

  /* Móvil: palabras encima y debajo de la taza, a todo el ancho */
  @media (max-width: 760px) {
    .hero { --taza: 56vw; }
    .hero__cabecera { margin-top: 3.2rem; --titulo: 27vw; }
    .hero__fila { grid-template-columns: 100%; justify-items: center; margin-top: 1.5rem; column-gap: 0; }
    .hero__palabra--izq, .hero__palabra--der { justify-self: center; }
    .hero__palabra--der { order: 3; }
    .hero__taza { width: var(--taza); margin-top: 0.6rem; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { seguirPuntero } from '../../scripts/puntero';
  import { posicionEnDocumento } from '../../scripts/geometria';

  // Centro y radio del plato dentro de la imagen de la taza (fracciones del ancho/alto)
  const PLATO = { cx: 0.5344, cy: 0.4994, r: 0.4622 };
  const ARCO = 2.1; // ángulo (rad) que ocupa "Cafetería" en la curva inferior
  const X_MEDIA = 0.62; // centro de la x de Cormorant respecto a la caja (line-height 1)

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const fila = hero.querySelector<HTMLElement>('[data-fila]')!;
  const marco = hero.querySelector<HTMLElement>('[data-taza]')!;
  const taza = hero.querySelector<HTMLImageElement>('[data-taza-img]')!;
  const sombra = hero.querySelector<HTMLElement>('[data-taza-sombra]')!;
  const trazo = hero.querySelector<SVGSVGElement>('[data-trazo]')!;
  const linea = (id: string) => hero.querySelector<SVGPathElement>(`[data-linea="${id}"]`)!;
  const arco = hero.querySelector<SVGPathElement>('[data-arco]')!;
  const cafeteria = hero.querySelector<SVGTextElement>('[data-cafeteria]')!;
  const medida = hero.querySelector<SVGTextElement>('[data-cafeteria-medida]')!;
  const [izq, der] = [...hero.querySelectorAll<HTMLElement>('[data-palabra]')];
  const bajar = hero.querySelector<HTMLElement>('[data-bajar]')!;

  const movil = () => window.matchMedia('(max-width: 760px)').matches;

  /** Tamaño de "Cafetería" y radio del arco, para que llene la curva sin tocar el plato. */
  function medirCafeteria(rPlato: number) {
    medida.setAttribute('font-size', '100');
    const k = medida.getComputedTextLength() / 100; // longitud por px de fuente
    // L = k·fs ha de ocupar ARCO·R, con R = rPlato + 0.5·fs + 18 (hueco para las ascendentes)
    const ideal = (ARCO * (rPlato + 18)) / (k - 0.5 * ARCO);
    // Si la medida falla (k demasiado pequeño), un tamaño razonable en vez de uno negativo
    const fs = ideal > 0 ? Math.min(ideal, rPlato * 0.7) : rPlato * 0.3;
    return { fs, R: rPlato + 0.5 * fs + 18 };
  }

  function encajar(p: HTMLElement, ancho: number) {
    p.style.translate = '0 0';
    p.style.fontSize = '100px';
    const w = p.getBoundingClientRect().width;
    if (w > 0) p.style.fontSize = `${(100 * ancho) / w}px`;
  }

  /**
   * Trazado de izquierda a derecha: línea horizontal a la altura `y` que rodea
   * el círculo (cx, cy, r) por abajo (lado = 1) o por arriba (lado = -1), con
   * empalmes circulares para que la entrada en la curva sea gradual.
   */
  function curva(cx: number, cy: number, r: number, y: number, ancho: number, lado: 1 | -1): string {
    const f = r * 0.45; // radio del empalme
    const fy = y + lado * f; // centro del empalme, al otro lado de la línea
    const dx = Math.sqrt(Math.max((r + f) ** 2 - (fy - cy) ** 2, 0));
    const k = r / (r + f); // punto de contacto entre empalme y círculo
    const n = (v: number) => v.toFixed(1);
    const tx = (s: 1 | -1) => cx + s * dx * k;
    const ty = cy + (fy - cy) * k;
    // Por abajo: empalmes en sentido horario y círculo antihorario; por arriba, al revés
    const bEmpalme = lado === 1 ? 1 : 0;
    const bCirculo = 1 - bEmpalme;
    return `M0 ${n(y)}H${n(cx - dx)}`
      + `A${n(f)} ${n(f)} 0 0 ${bEmpalme} ${n(tx(-1))} ${n(ty)}`
      + `A${n(r)} ${n(r)} 0 0 ${bCirculo} ${n(tx(1))} ${n(ty)}`
      + `A${n(f)} ${n(f)} 0 0 ${bEmpalme} ${n(cx + dx)} ${n(y)}`
      + `H${n(ancho)}`;
  }

  function maquetar() {
    const W = marco.offsetWidth;
    const H = marco.offsetHeight;
    const rPlato = PLATO.r * W;
    const { fs, R } = medirCafeteria(rPlato);
    cafeteria.setAttribute('font-size', fs.toFixed(1));

    if (movil()) {
      fila.style.removeProperty('--hueco');
      encajar(izq, fila.clientWidth * 0.86);
      encajar(der, fila.clientWidth * 0.86);
      // Pastelería por debajo de Cafetería
      const bajoTexto = PLATO.cy * H + R + 0.35 * fs - H;
      der.style.marginTop = `${Math.max(12, bajoTexto + 10)}px`;
    } else {
      der.style.marginTop = '';
      // El arco sobresale de la caja de la taza: el hueco lateral ha de cubrirlo
      const sobra = Math.max(R - PLATO.cx * W, R - (1 - PLATO.cx) * W);
      const hueco = Math.max(sobra + 28, 40);
      fila.style.setProperty('--hueco', `${hueco}px`);
      const ancho = ((fila.clientWidth - W - hueco * 2) / 2) * 0.97;
      encajar(izq, ancho);
      encajar(der, ancho);
    }

    // Coordenadas dentro de la fila
    const f = fila.getBoundingClientRect();
    const t = marco.getBoundingClientRect();
    const cx = t.left - f.left + PLATO.cx * W;
    const cy = t.top - f.top + PLATO.cy * H;

    // En escritorio, el centro de la x de cada palabra cae justo en la línea
    if (!movil()) {
      [izq, der].forEach((p) => {
        const b = p.getBoundingClientRect();
        const xMedia = b.top - f.top + X_MEDIA * b.height;
        p.style.translate = `0 ${(cy - xMedia).toFixed(1)}px`;
      });
    }

    const ancho = fila.clientWidth;
    trazo.setAttribute('width', String(ancho));
    trazo.setAttribute('height', String(fila.clientHeight));
    trazo.setAttribute('viewBox', `0 0 ${ancho} ${fila.clientHeight}`);

    // Las dos líneas, a la misma distancia del centro (simétricas), sin tocar las letras
    const fsP = parseFloat(getComputedStyle(izq).fontSize);
    const d = movil() ? 0 : 0.62 * fsP;
    const r = R + 0.42 * fs; // por fuera de "Cafetería"
    linea('abajo').setAttribute('d', curva(cx, cy, r, cy + d, ancho, 1));
    linea('arriba').setAttribute('d', curva(cx, cy, r, cy - d, ancho, -1));
    // En móvil las palabras van encima y debajo: la línea de arriba cruzaría "Panadería"
    linea('arriba').style.display = movil() ? 'none' : '';
    arco.setAttribute('d', `M${cx - R} ${cy}A${R} ${R} 0 0 0 ${cx + R} ${cy}`);

    // En pantallas bajas la flecha de bajar caería encima de "Pastelería": entonces no se muestra
    const finPalabras = Math.max(izq.getBoundingClientRect().bottom, der.getBoundingClientRect().bottom);
    bajar.style.visibility = finPalabras > bajar.getBoundingClientRect().top - 8 ? 'hidden' : '';
  }

  function entrar() {
    gsap.set([marco, izq, der, trazo], { opacity: 1 });
    gsap.timeline()
      .fromTo(marco, { rotate: -140, scale: 0.4, opacity: 0 }, { rotate: 0, scale: 1, opacity: 1, duration: 1.6, ease: 'expo.out' })
      .from(izq, { xPercent: -25, opacity: 0, duration: 1.5, ease: 'expo.out' }, 0.8)
      .from(der, { xPercent: 25, opacity: 0, duration: 1.5, ease: 'expo.out' }, 0.8)
      // pathLength 1000: GSAP redondea a px enteros, con longitud 1 la línea saltaba de golpe
      .fromTo(linea('abajo'), { strokeDasharray: 1000, strokeDashoffset: 1000 }, { strokeDashoffset: 0, duration: 2.2, ease: 'power2.inOut' }, 0.8)
      // la de arriba se dibuja desde su final: de derecha a izquierda
      .fromTo(linea('arriba'), { strokeDasharray: 1000, strokeDashoffset: -1000 }, { strokeDashoffset: 0, duration: 2.2, ease: 'power2.inOut' }, 0.8)
      .from(cafeteria, { opacity: 0, duration: 1.5, ease: 'expo.out' }, 0.8);
  }

  // Centro de la taza en el documento: se mide al maquetar, no en cada movimiento del ratón
  let centroTaza = { x: 0, y: 0 };
  const medirTaza = () => {
    const t = posicionEnDocumento(marco);
    centroTaza = { x: t.x + t.w / 2, y: t.y + t.h / 2 };
  };

  // Rehacer la maqueta como mucho una vez por fotograma, y solo si cambia lo que la afecta:
  // en móvil, mostrar u ocultar la barra del navegador al hacer scroll solo cambia el alto.
  let ultimo = { w: window.innerWidth, h: window.innerHeight };
  let pendiente = false;
  const alRedimensionar = () => {
    const w = window.innerWidth;
    const h = window.innerHeight;
    if (w === ultimo.w && (movil() || h === ultimo.h)) return;
    ultimo = { w, h };
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      maquetar();
      medirTaza();
    });
  };

  // Esperar a la fuente y a la imagen para medir bien y que nada se vea a medias
  Promise.all([document.fonts.ready, taza.decode().catch(() => {})]).then(() => {
    maquetar();
    medirTaza();
    entrar();
    window.addEventListener('resize', alRedimensionar);
  });

  // Ratón: la taza gira un poco y su sombra se aleja del cursor.
  // Va sobre las imágenes; la entrada anima el contenedor, así no se pisan.
  const giro = gsap.quickTo(taza, 'rotate', { duration: 1.2, ease: 'power3.out' });
  const sx = gsap.quickTo(sombra, 'x', { duration: 0.6, ease: 'power3.out' });
  const sy = gsap.quickTo(sombra, 'y', { duration: 0.6, ease: 'power3.out' });
  const sr = gsap.quickTo(sombra, 'rotate', { duration: 1.2, ease: 'power3.out' });

  seguirPuntero(hero, (x, y) => {
    const dx = centroTaza.x - x;
    const dy = centroTaza.y - window.scrollY - y;
    const dist = Math.hypot(dx, dy) || 1;
    const mag = Math.min(dist * 0.08, 60);
    sx((dx / dist) * mag);
    sy((dy / dist) * mag);
    const angulo = (x / window.innerWidth - 0.5) * 24;
    giro(angulo);
    sr(angulo);
  });
</script>

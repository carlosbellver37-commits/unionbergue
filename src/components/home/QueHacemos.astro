---
/**
 * "Qué hacemos": barra con los siete servicios y el expositor de siete
 * compartimentos. Cada compartimento tiene su producto en sepia; al pasar el
 * ratón pasa a color; al elegirlo (clic en el expositor o en la barra) se carga
 * justo debajo el sector completo, sin salir de la página.
 * Imágenes: herramientas/productos_expositor.py → /img/expositor/<id>-{sepia,color}.webp
 */
import TituloMarca from '../ui/TituloMarca.astro';
import Sector from './Sector.astro';
import VisorCatalogo from './VisorCatalogo.astro';
import LineaGuia from '../ui/LineaGuia.astro';

interface Servicio {
  id: string;
  nombre: string;
  especialidad: string;
  texto: string;
  /** Tiene pareja de imágenes en /img/expositor */
  imagen?: boolean;
}

const servicios: Servicio[] = [
  {
    id: 'pasteleria', nombre: 'Pastelería', imagen: true,
    especialidad: 'Tarta Selva Negra',
    texto: 'Bizcocho de chocolate, nata y cerezas. Una de las más de treinta tartas de la carta, junto a pasteles, mousses y pastas de té.',
  },
  {
    id: 'pan', nombre: 'Pan y bollería', imagen: true,
    especialidad: 'Baguette artesana',
    texto: 'Corteza crujiente y miga alveolada, de fermentación lenta. Cada mañana horneamos diecisiete panes distintos y bollería del día.',
  },
  {
    id: 'salados', imagen: true, nombre: 'Salados',
    especialidad: 'Empanada de hojaldre',
    texto: 'Medias noches, quiches, empanadas y bandejas saladas para cumpleaños y reuniones familiares.',
  },
  {
    id: 'temporada', imagen: true, nombre: 'Temporada',
    especialidad: 'Roscón de Reyes',
    texto: 'Cada fiesta tiene su dulce: roscón, torrijas, rosquillas de San Isidro, huesos de santo y turrones.',
  },
  {
    id: 'cafeteria', imagen: true, nombre: 'Cafetería',
    especialidad: 'Café de Colombia de la casa',
    texto: 'Desayunos con bollería del día, tostadas variadas, bocadillos, tortitas, gofres y chocolate con churros.',
  },
  {
    id: 'gourmet', imagen: true, nombre: 'Gourmet',
    especialidad: 'Ibéricos y quesos',
    texto: 'Vinos, cavas, foie, conservas, mermeladas artesanas de Extremadura, miel 100 % pura, cafés de origen y bombones.',
  },
  {
    id: 'heladeria', imagen: true, nombre: 'Heladería',
    especialidad: 'Helado artesano',
    texto: 'Cucuruchos y copas de helado, granizados, batidos, sorbetes, smoothies y frappelatte.',
  },
];

// Centro de cada compartimento en la ilustración (px de 1392 de ancho; suelo a 300 de 545)
const CENTROS = [205, 363, 526, 692, 860, 1025, 1188];
const ANCHO = 1392;
const ALTO = 545;
const SUELO = 300;
---

<section class="hacemos" id="que-hacemos" aria-labelledby="hacemos-titulo" data-hacemos>
  <LineaGuia variante="hacemos" />
  <TituloMarca texto="Qué hacemos" id="hacemos-titulo" nivel="h2" class="hacemos__titulo" />

  <p class="hacemos__sub" data-reveal>Todo lo que hacemos,<br /><em>en siete mostradores</em></p>

  <nav class="hacemos__barra" aria-label="Nuestros servicios" data-reveal>
    <ul>
      {servicios.map((s) => (
        <li>
          <button type="button" aria-pressed="false" aria-controls="hacemos-sectores" data-elegir={s.id}>{s.nombre}</button>
        </li>
      ))}
    </ul>
  </nav>

  <figure class="expositor" data-reveal>
    <img
      class="expositor__fondo"
      src="/img/expositor.webp"
      srcset="/img/expositor-900.webp 900w, /img/expositor.webp 1392w"
      sizes="(max-width: 760px) 100vw, 50rem"
      alt="Expositor Bergue con un producto de cada servicio"
      width={ANCHO}
      height={ALTO}
      loading="lazy"
    />
    {servicios.map((s, i) => (
      <button
        type="button"
        class="expositor__hueco"
        style={`left:${(CENTROS[i] / ANCHO) * 100}%;bottom:${((ALTO - SUELO) / ALTO) * 100}%`}
        aria-label={`${s.nombre}: ${s.especialidad}`}
        aria-controls="hacemos-sectores"
        data-hueco={s.id}
      >
        {s.imagen && (
          <>
            <img class="expositor__sepia" src={`/img/expositor/${s.id}-sepia.webp`} alt="" loading="lazy" />
            <img class="expositor__color" src={`/img/expositor/${s.id}-color.webp`} alt="" loading="lazy" />
          </>
        )}
      </button>
    ))}
  </figure>

  <p class="pista" data-pista>Pasa por el expositor y elige un mostrador</p>

  <!-- Sector elegido: se carga aquí, justo bajo el expositor -->
  <div class="sectores" id="hacemos-sectores" data-sectores>
  {servicios.map((s) => (
    <section class="sector" id={`sector-${s.id}`} aria-labelledby={`sector-${s.id}-t`} data-sector={s.id} hidden>
      <header class="sector__cabeza wrap">
        <h3 class="sector__titulo" id={`sector-${s.id}-t`}>{s.nombre}</h3>
        <button type="button" class="sector__cerrar" data-cerrar>Cerrar <span aria-hidden="true">×</span></button>
      </header>
      <Sector id={s.id} />
    </section>
  ))}
  </div>
  <VisorCatalogo />
</section>

<style>
  .hacemos {
    --cafe: #3a241c;
    --terracota: #964b36;
    --fondo: #f4eee0;
  }
  .hacemos {
    position: relative;
    background: var(--fondo);
    padding: clamp(3rem, 8vw, 7rem) 0 var(--space-section);
    display: grid;
    justify-items: center;
    text-align: center;
  }
  .hacemos :global(.hacemos__titulo) { font-size: clamp(3.5rem, 11vw, 11rem); justify-self: start; margin-left: var(--gutter); }

  .hacemos__sub {
    justify-self: start;
    margin: clamp(1rem, 2.5vw, 2rem) 0 0 var(--gutter);
    text-align: left;
    font-family: 'Cormorant Garamond', 'Garamond', serif;
    font-weight: 300;
    font-size: clamp(1.6rem, 1rem + 2.4vw, 3.2rem);
    line-height: 1.1;
    color: var(--cafe);
  }
  .hacemos__sub em { font-style: italic; color: var(--terracota); }

  /* Barra de servicios en marrón café, letras del color del fondo */
  .hacemos__barra {
    width: min(100% - var(--gutter) * 2, 72rem);
    margin-top: clamp(2rem, 4vw, 3.5rem);
    background: var(--cafe);
    border-radius: 999px;
    padding: 0.4rem;
  }
  .hacemos__barra ul { list-style: none; padding: 0; display: flex; justify-content: space-between; gap: 0.25rem; }
  .hacemos__barra button {
    padding: 0.75rem clamp(0.6rem, 1.2vw, 1.3rem);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--fondo);
    font-size: clamp(0.85rem, 0.7rem + 0.35vw, 1.05rem);
    letter-spacing: 0.06em;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast), color var(--dur-fast);
  }
  .hacemos__barra button:hover,
  .hacemos__barra button:focus-visible,
  .hacemos__barra button[aria-pressed='true'] { background: var(--fondo); color: var(--cafe); }

  /* Expositor con un producto en cada compartimento */
  .expositor { position: relative; margin: clamp(2.5rem, 5vw, 4.5rem) 0 0; width: min(100% - var(--gutter) * 2, 50rem); }
  .expositor__fondo { width: 100%; height: auto; }

  .expositor__hueco {
    position: absolute;
    width: 12.5%;
    height: 50%;
    translate: -50% 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .expositor__hueco img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    transform-origin: 50% 100%;
    transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
  }
  .expositor__color { opacity: 0; }
  .expositor__hueco.is-activo img { transform: translateY(-4%) scale(1.06); }
  .expositor__hueco.is-activo .expositor__color { opacity: 1; }
  .expositor__hueco.is-activo .expositor__sepia { opacity: 0; }
  .expositor__hueco:focus-visible { outline-offset: 6px; }

  .pista {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    font-family: 'Cormorant Garamond', 'Garamond', serif;
    font-style: italic;
    font-size: var(--text-lg);
    color: var(--terracota);
    opacity: 0.8;
  }
  .pista[hidden] { display: none; }
  @keyframes aparecer {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }

  /* Sector cargado bajo el expositor */
  .sectores { justify-self: stretch; text-align: left; }
  .sector[hidden] { display: none; }
  .sector { animation: aparecer 700ms var(--ease-out); }
  .sector__cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(1rem, 3vw, 2rem);
  }
  .sector__titulo {
    font-family: 'Fraunces Variable', serif;
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
    font-size: clamp(2.6rem, 1rem + 6vw, 6.5rem);
    letter-spacing: -0.04em;
    line-height: 0.9;
    color: var(--terracota);
  }
  .sector__cerrar {
    border: 0;
    background: none;
    color: var(--cafe);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    cursor: pointer;
    border-bottom: 1px solid currentColor;
  }
  .sector__cerrar:hover { color: var(--terracota); }

  /* Tablet y móvil: todas las opciones a la vista, repartidas en varias filas */
  @media (max-width: 1100px) {
    .hacemos__barra { border-radius: 1.6rem; padding: 0.5rem; }
    .hacemos__barra ul { flex-wrap: wrap; justify-content: center; gap: 0.35rem; }
    .hacemos__barra button { padding: 0.6rem 0.95rem; border: 1px solid rgb(244 238 224 / 0.25); }
  }
</style>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { desplazarA } from '../../scripts/motion';

  const raiz = document.querySelector<HTMLElement>('[data-hacemos]');
  const sectores = [...document.querySelectorAll<HTMLElement>('[data-sector]')];

  if (raiz) {
    const huecos = [...raiz.querySelectorAll<HTMLElement>('[data-hueco]')];
    const botones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-elegir]')];
    const pista = raiz.querySelector<HTMLElement>('[data-pista]');

    let elegido: string | null = null; // por clic (barra o expositor): carga el sector
    let encima: string | null = null; // por ratón sobre el expositor: solo lo pasa a color

    const pintar = () => {
      const activo = encima ?? elegido;
      huecos.forEach((h) => h.classList.toggle('is-activo', h.dataset.hueco === activo));
      botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.elegir === elegido)));
      if (pista) pista.hidden = elegido !== null;
    };

    /** Muestra el sector elegido y, ya recolocada la página, ejecuta `luego` (p. ej. desplazarse). */
    const cargarSector = (luego?: () => void) => {
      sectores.forEach((s) => { s.hidden = s.dataset.sector !== elegido; });
      // Las alturas cambian: recalcular las animaciones ligadas al scroll del resto de la página
      // antes de desplazarse (el refresh mide la página y movería el scroll a medias)
      requestAnimationFrame(() => {
        ScrollTrigger.refresh();
        luego?.();
      });
    };

    const elegir = (id: string | null, luego?: () => void) => {
      elegido = elegido === id ? null : id;
      pintar();
      cargarSector(luego);
    };

    botones.forEach((b) => b.addEventListener('click', () => elegir(b.dataset.elegir!)));
    huecos.forEach((h) => {
      h.addEventListener('click', () => elegir(h.dataset.hueco!));
      h.addEventListener('pointerenter', (e) => {
        if (e.pointerType === 'touch') return;
        encima = h.dataset.hueco!;
        pintar();
      });
      h.addEventListener('pointerleave', () => {
        encima = null;
        pintar();
      });
    });
    // Enlaces externos (menú): /#pasteleria, /#pan… abren su sector y bajan hasta él
    const ids = huecos.map((h) => h.dataset.hueco!);
    const desdeHash = () => {
      const id = location.hash.slice(1).replace(/^sector-/, '');
      if (!ids.includes(id)) return;
      elegido = id;
      pintar();
      cargarSector(() => {
        const destino = document.getElementById(`sector-${id}`);
        if (destino) desplazarA(destino);
      });
    };
    desdeHash();
    window.addEventListener('hashchange', desdeHash);
    // Si ya estamos en la portada, el mismo enlace vuelve a abrir el sector aunque el hash no cambie
    document.addEventListener('click', (e) => {
      const enlace = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="/#"]');
      if (!enlace || location.pathname !== '/') return;
      const id = enlace.hash.slice(1);
      if (!ids.includes(id)) return;
      e.preventDefault();
      history.replaceState(null, '', `#${id}`);
      desdeHash();
    });

    document.querySelectorAll<HTMLButtonElement>('[data-cerrar]').forEach((b) =>
      b.addEventListener('click', () => {
        elegir(null, () => {
          const expositor = raiz.querySelector<HTMLElement>('.expositor');
          if (expositor) desplazarA(expositor, 'center');
        });
      }),
    );
  }
</script>

---
/**
 * Línea temporal orientativa del año dulce: una línea fina de enero a diciembre
 * con cada campaña en su fecha aproximada y una marca en el día de hoy.
 * Las fechas móviles (Semana Santa) son aproximadas.
 */
const MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];

// mes: posición en el año (1 = 1 de enero, 12.97 ≈ 31 de diciembre)
const HITOS = [
  { mes: 1.15, nombre: 'Roscón de Reyes', fecha: '6 de enero', detalle: 'nata, trufa o crema' },
  { mes: 3.75, nombre: 'Torrijas', fecha: 'Semana Santa', detalle: 'marzo – abril' },
  { mes: 4.2, nombre: 'Monas de Pascua', fecha: 'Pascua', detalle: 'y huevos de chocolate' },
  { mes: 5.47, nombre: 'Rosquillas', fecha: '15 de mayo · San Isidro', detalle: 'tontas, listas y de Santa Clara' },
  { mes: 10.75, nombre: 'Huesos de santo y buñuelos', fecha: 'Todos los Santos', detalle: 'finales de octubre – 1 de noviembre' },
  { mes: 11.27, nombre: 'Corona de la Almudena', fecha: '9 de noviembre', detalle: 'patrona de Madrid' },
  { mes: 12.15, nombre: 'Turrones y mazapanes', fecha: 'Navidad', detalle: 'diciembre' },
];

const pos = (mes: number) => ((mes - 1) / 12) * 100;
---

<div class="linea-t wrap" data-linea-t>
  <h4 class="linea-t__titulo">El año dulce <span>· calendario orientativo</span></h4>

  <div class="linea-t__eje">
    <span class="linea-t__trazo" data-linea-t-trazo></span>
    <ol class="linea-t__meses" aria-hidden="true">
      {MESES.map((m) => <li>{m}</li>)}
    </ol>
    <span class="linea-t__hoy" data-linea-t-hoy hidden><span>hoy</span></span>

    <ol class="linea-t__hitos">
      {HITOS.map((h, i) => (
        <li
          class:list={['hito', i % 2 ? 'hito--abajo' : 'hito--arriba']}
          style={`--x:${pos(h.mes)}%;--d:${i * 0.12}s;--ancla:${pos(h.mes) < 5 ? '-12%' : pos(h.mes) > 95 ? '-88%' : '-50%'}`}
          data-mes={h.mes}
        >
          <span class="hito__punto" aria-hidden="true"></span>
          <span class="hito__texto">
            <strong>{h.nombre}</strong>
            <span>{h.fecha}</span>
            <em>{h.detalle}</em>
          </span>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
  .linea-t { padding-bottom: clamp(3rem, 6vw, 5rem); color: #3a241c; }
  .linea-t__titulo {
    font-family: 'Cormorant Garamond', 'Garamond', serif;
    font-weight: 500;
    font-size: clamp(1.6rem, 1rem + 1.6vw, 2.4rem);
    margin-bottom: 1rem;
  }
  .linea-t__titulo span { font-style: italic; font-weight: 400; font-size: 0.6em; color: #964b36; }

  .linea-t__eje { position: relative; height: 22rem; }
  .linea-t__trazo {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.2px;
    background: #964b36;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.8s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .linea-t.is-visible .linea-t__trazo { transform: scaleX(1); }

  .linea-t__meses {
    list-style: none;
    padding: 0;
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + 0.5rem);
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #964b36;
    opacity: 0.6;
  }
  .linea-t__meses li { padding-left: 0.3rem; border-left: 1px solid rgb(150 75 54 / 0.35); height: 0.9rem; line-height: 1.4; }

  .linea-t__hoy {
    position: absolute;
    top: calc(50% - 2.2rem);
    height: 4.4rem;
    width: 0;
    border-left: 1px dashed #3a241c;
  }
  .linea-t__hoy span {
    position: absolute;
    top: -1.4rem;
    left: 0;
    translate: -50% 0;
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .linea-t__hitos { list-style: none; padding: 0; }
  .hito {
    position: absolute;
    left: var(--x);
    top: 50%;
    opacity: 0;
    transition: opacity 0.6s ease, translate 0.6s ease;
    transition-delay: calc(0.9s + var(--d));
  }
  .linea-t.is-visible .hito { opacity: 1; }
  .hito__punto {
    position: absolute;
    left: 0;
    top: 0;
    width: 9px;
    height: 9px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #f4eee0;
    border: 1.5px solid #964b36;
  }
  .hito::before {
    content: '';
    position: absolute;
    left: 0;
    width: 1px;
    background: #964b36;
    opacity: 0.5;
  }
  .hito--arriba::before { bottom: 0.5rem; height: 2.4rem; }
  .hito--abajo::before { top: 0.5rem; height: 3.6rem; }
  .hito__texto {
    position: absolute;
    left: 0;
    translate: var(--ancla, -50%) 0;
    width: max-content;
    max-width: 11rem;
    display: grid;
    gap: 0.1rem;
    text-align: center;
  }
  .hito--arriba .hito__texto { bottom: 3.1rem; }
  .hito--abajo .hito__texto { top: 4.3rem; }
  .hito__texto strong { font-family: 'Cormorant Garamond', 'Garamond', serif; font-weight: 500; font-size: var(--text-lg); line-height: 1.05; }
  .hito__texto span { font-size: var(--text-xs); letter-spacing: 0.06em; color: #964b36; }
  .hito__texto em { font-size: var(--text-xs); color: #5a4034; }
  .hito.is-ahora .hito__punto { background: #964b36; box-shadow: 0 0 0 5px rgb(150 75 54 / 0.2); }

  /* Móvil: en vertical */
  @media (max-width: 760px) {
    .linea-t__eje { height: auto; padding-left: 1.5rem; }
    .linea-t__trazo { left: 0.3rem; right: auto; top: 0; bottom: 0; width: 1.2px; height: auto; transform-origin: top; transform: scaleY(0); }
    .linea-t.is-visible .linea-t__trazo { transform: scaleY(1); }
    .linea-t__meses, .linea-t__hoy { display: none; }
    .linea-t__hitos { display: grid; gap: 1.4rem; }
    .hito { position: relative; left: auto; top: auto; }
    .hito::before { display: none; }
    .hito__punto { left: -1.2rem; top: 0.7rem; }
    .hito__texto { position: static; translate: none; text-align: left; max-width: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-linea-t]').forEach((linea) => {
    // Marca de hoy y campaña más cercana
    const ahora = new Date();
    const dias = new Date(ahora.getFullYear(), ahora.getMonth() + 1, 0).getDate();
    const mes = ahora.getMonth() + 1 + (ahora.getDate() - 1) / dias;
    const hoy = linea.querySelector<HTMLElement>('[data-linea-t-hoy]');
    if (hoy) {
      hoy.style.left = `${((mes - 1) / 12) * 100}%`;
      hoy.hidden = false;
    }
    const hitos = [...linea.querySelectorAll<HTMLElement>('[data-mes]')];
    const siguiente = hitos.find((h) => Number(h.dataset.mes) >= mes - 0.3) ?? hitos[0];
    siguiente?.classList.add('is-ahora');

    // Se dibuja al aparecer en pantalla
    new IntersectionObserver((entradas, obs) => {
      if (entradas.some((e) => e.isIntersecting)) {
        linea.classList.add('is-visible');
        obs.disconnect();
      }
    }, { threshold: 0.3 }).observe(linea);
  });
</script>

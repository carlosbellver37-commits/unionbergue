---
/**
 * Línea fina terracota que acompaña el scroll: une dos elementos de la sección
 * (por ejemplo, un título y la esquina de una ilustración) con esquinas
 * redondeadas, y se dibuja a medida que la sección entra en pantalla.
 * El recorrido lo calcula el script según la variante.
 *
 *  conocenos-arriba: por encima del título, recta casi hasta el borde derecho
 *  conocenos: bajo el título → derecha → baja hasta la esquina del local
 *  hacemos:   tras el título → borde derecho → baja junto a la barra → esquina del expositor
 */
interface Props {
  variante: 'conocenos-arriba' | 'conocenos' | 'hacemos';
}
const { variante } = Astro.props;
---

<svg class="linea-guia" aria-hidden="true" data-linea-guia={variante}>
  <path pathLength="1000" />
</svg>

<style>
  .linea-guia {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 0;
  }
  .linea-guia path {
    fill: none;
    stroke: #964b36;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
  }
  /* En móvil no hay margen lateral por el que pasar */
  @media (max-width: 760px) {
    .linea-guia { display: none; }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  type P = [number, number];

  /** Polilínea con las esquinas redondeadas (radio r, recortado si el tramo es corto). */
  function redondeada(puntos: P[], r: number): string {
    const n = (v: number) => v.toFixed(1);
    let d = `M${n(puntos[0][0])} ${n(puntos[0][1])}`;
    for (let i = 1; i < puntos.length - 1; i++) {
      const [ax, ay] = puntos[i - 1];
      const [bx, by] = puntos[i];
      const [cx, cy] = puntos[i + 1];
      const l1 = Math.hypot(bx - ax, by - ay) || 1;
      const l2 = Math.hypot(cx - bx, cy - by) || 1;
      const k = Math.min(r, l1 / 2, l2 / 2);
      d += `L${n(bx - ((bx - ax) / l1) * k)} ${n(by - ((by - ay) / l1) * k)}`;
      d += `Q${n(bx)} ${n(by)} ${n(bx + ((cx - bx) / l2) * k)} ${n(by + ((cy - by) / l2) * k)}`;
    }
    const [ux, uy] = puntos[puntos.length - 1];
    return `${d}L${n(ux)} ${n(uy)}`;
  }

  /**
   * Rectángulo de un elemento relativo a su sección, sin contar transformaciones
   * (las animaciones de entrada desplazan los elementos mientras se mide).
   */
  function rect(el: Element | null, seccion: HTMLElement) {
    if (!(el instanceof HTMLElement)) return null;
    let x = 0;
    let y = 0;
    let n: HTMLElement | null = el;
    while (n && n !== seccion) {
      x += n.offsetLeft;
      y += n.offsetTop;
      n = n.offsetParent as HTMLElement | null;
    }
    const w = el.offsetWidth;
    const h = el.offsetHeight;
    return { l: x, r: x + w, t: y, b: y + h, w, h };
  }

  const RECORRIDOS: Record<string, (s: HTMLElement, base: DOMRect) => P[] | null> = {
    'conocenos-arriba': (s, base) => {
      const titulo = rect(s.querySelector('.titulo-marca__letras'), s);
      if (!titulo) return null;
      const y = Math.max(8, titulo.t - 6);
      return [[titulo.l, y], [base.width * 0.965, y]];
    },
    conocenos: (s, base) => {
      const titulo = rect(s.querySelector('.titulo-marca__letras'), s);
      const local = rect(s.querySelector('.fachada'), s);
      if (!titulo || !local) return null;
      const y = titulo.b + 14;
      return [[titulo.l, y], [local.r, y], [local.r, local.t + 6]];
    },
    hacemos: (s, base) => {
      const titulo = rect(s.querySelector('.titulo-marca__letras'), s);
      const expositor = rect(s.querySelector('.expositor'), s);
      if (!titulo || !expositor) return null;
      const y = titulo.t + titulo.h * 0.62;
      const barra = rect(s.querySelector('.hacemos__barra'), s);
      // Baja por el margen derecho, sin tocar la barra de servicios
      const x = Math.min(base.width - 10, Math.max((barra?.r ?? 0) + 20, base.width - (base.width - expositor.r) * 0.35));
      // Termina en la esquina del techo del expositor
      const yExp = expositor.t + expositor.h * 0.03;
      return [[titulo.r + 24, y], [x, y], [x, yExp], [expositor.r - expositor.w * 0.045, yExp]];
    },
  };

  document.querySelectorAll<SVGSVGElement>('[data-linea-guia]').forEach((svg) => {
    const seccion = svg.parentElement as HTMLElement;
    const path = svg.querySelector('path')!;
    const recorrido = RECORRIDOS[svg.dataset.lineaGuia!];

    const trazar = () => {
      const base = seccion.getBoundingClientRect();
      const puntos = recorrido(seccion, base);
      if (!puntos) return;
      svg.setAttribute('viewBox', `0 0 ${base.width} ${base.height}`);
      path.setAttribute('d', redondeada(puntos, 46));
    };

    document.fonts.ready.then(() => {
      trazar();
      // Cubre también los cambios de ventana (cambia el ancho de la sección); antes había
      // además un listener de resize que repetía el mismo trabajo
      new ResizeObserver(trazar).observe(seccion);
      gsap.to(path, {
        strokeDashoffset: 0,
        ease: 'none',
        scrollTrigger: { trigger: seccion, start: 'top 75%', end: 'top 25%', scrub: 0.8 },
      });
    });
  });
</script>

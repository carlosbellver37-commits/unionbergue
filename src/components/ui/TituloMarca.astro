---
/**
 * Título grande en serif setentera terracota. Cada letra se desplaza e
 * inclina con el ratón a distinta profundidad (los extremos se mueven más).
 */
interface Props {
  texto: string;
  id?: string;
  /** Texto para lectores de pantalla si difiere del visible. */
  etiqueta?: string;
  class?: string;
  /** h1 en la portada de cada página; h2 si va en una sección. */
  nivel?: 'h1' | 'h2';
}
const { texto, id, etiqueta = texto, class: className = '', nivel = 'h1' } = Astro.props;
const Etiqueta = nivel;
---

<Etiqueta id={id} class:list={['titulo-marca', className]} style={`--n:${[...texto].length}`} data-titulo-marca>
  <span class="sr-only">{etiqueta}</span>
  <span class="titulo-marca__letras" aria-hidden="true">
    {[...texto].map((l) => <span class="titulo-marca__letra" data-letra>{l === ' ' ? ' ' : l}</span>)}
  </span>
</Etiqueta>

<style>
  .titulo-marca {
    font-family: 'Fraunces Variable', serif;
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
    /* Escala según el número de letras: 6 letras ≈ 21vw */
    font-size: clamp(4rem, calc(126vw / var(--n)), min(21rem, 32svh));
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: #964b36;
  }
  .titulo-marca__letras { display: inline-flex; padding-top: 0.12em; }
  .titulo-marca__letra { display: inline-block; }
  /* Oculto hasta que el script lo hace entrar (evita que se vea y desaparezca al cargar) */
  :global(.motion) .titulo-marca { opacity: 0; }

  @media (max-width: 760px) {
    .titulo-marca { font-size: calc(162vw / var(--n)); }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { seguirPuntero } from '../../scripts/puntero';

  gsap.registerPlugin(ScrollTrigger);

  document.querySelectorAll<HTMLElement>('[data-titulo-marca]').forEach((titulo) => {
    const letras = [...titulo.querySelectorAll<HTMLElement>('[data-letra]')].map((el, i, todas) => {
      const centro = (todas.length - 1) / 2;
      return {
        prof: 0.5 + Math.abs(i - centro) * 0.35,
        x: gsap.quickTo(el, 'x', { duration: 0.9, ease: 'power3.out' }),
        y: gsap.quickTo(el, 'y', { duration: 0.9, ease: 'power3.out' }),
        r: gsap.quickTo(el, 'rotate', { duration: 1.1, ease: 'power3.out' }),
      };
    });

    gsap.fromTo(
      titulo,
      { yPercent: 40, opacity: 0 },
      { yPercent: 0, opacity: 1, duration: 1.4, ease: 'expo.out', scrollTrigger: { trigger: titulo, start: 'top 90%' } },
    );

    // Solo mientras se ve, y una vez por fotograma (scripts/puntero.ts)
    seguirPuntero(titulo, (x, y) => {
      const nx = x / window.innerWidth - 0.5;
      const ny = y / window.innerHeight - 0.5;
      letras.forEach((l, i) => {
        l.x(nx * 26 * l.prof);
        l.y(ny * 18 * l.prof + Math.sin(i + nx * 3) * 4);
        l.r(nx * 6 * (i % 2 ? 1 : -1));
      });
    });
  });
</script>

---
// Botón flotante de encargos: abre WhatsApp si hay número de empresa y, si no,
// llama al teléfono fijo de la tienda.
import { hayWhatsapp, tiendas, whatsappUrl } from '../data/site';

const tienda = tiendas[0];
---

{hayWhatsapp ? (
  <a
    class="wa"
    href={whatsappUrl('Hola, quería hacer un encargo / consulta en Pastelería Bergue.')}
    target="_blank"
    rel="noopener"
    aria-label="Escríbenos por WhatsApp (se abre en una pestaña nueva)"
    data-wa
  >
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3zm0 23.7c-2 0-3.9-.5-5.6-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.7 10.7 0 1 1 16 26.7zm5.9-8c-.3-.2-1.9-1-2.2-1-.3-.2-.5-.2-.7.1l-1 1.2c-.2.2-.4.3-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5 1-1.7.1-.2 0-.4 0-.6l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.6 0-.9.4-.3.3-1.2 1.1-1.2 2.8s1.2 3.2 1.4 3.5c.2.2 2.4 3.7 5.8 5.1 2.2 1 3 1 4.1.9.7-.1 1.9-.8 2.2-1.6.3-.8.3-1.4.2-1.6l-.6-.3z"/></svg>
    <span class="wa__texto">Encargos por WhatsApp</span>
  </a>
) : (
  <a class="wa wa--tel" href={`tel:${tienda.telefonoHref}`} aria-label={`Llamar para encargos al ${tienda.telefono}`} data-wa>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
    <span class="wa__texto">Encargos · {tienda.telefono}</span>
  </a>
)}

<style>
  .wa {
    position: fixed; right: max(var(--gutter), env(safe-area-inset-right)); bottom: calc(1.25rem + env(safe-area-inset-bottom)); z-index: 45;
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.8rem; border-radius: 999px;
    background: var(--corteza); color: var(--harina);
    text-decoration: none; font-size: var(--text-xs); letter-spacing: 0.08em;
    box-shadow: 0 12px 30px rgb(51 32 15 / 0.3);
    transition: transform var(--dur) var(--ease-out), background-color var(--dur-fast);
  }
  .wa svg { width: 1.6rem; height: 1.6rem; flex: none; }
  .wa__texto {
    max-width: 0; overflow: hidden; white-space: nowrap;
    transition: max-width var(--dur) var(--ease-out), padding var(--dur) var(--ease-out);
  }
  .wa:hover, .wa:focus-visible { background: #1f7a4d; transform: translateY(-3px); }
  .wa--tel svg { width: 1.4rem; height: 1.4rem; margin: 0.1rem; }
  .wa--tel:hover, .wa--tel:focus-visible { background: var(--caramelo); }
  .wa:hover .wa__texto, .wa:focus-visible .wa__texto { max-width: 14rem; padding-right: 0.5rem; }
  /* Oculto: fuera de la pantalla y fuera del orden de tabulación */
  .wa.is-oculto {
    transform: translateY(150%);
    visibility: hidden;
    transition: transform var(--dur) var(--ease-out), visibility 0s linear var(--dur);
  }
</style>

<script>
  // Se aparta cuando taparía contenido: la portada en móvil (cubría "Pastelería")
  // y la franja final del pie, donde ya están los contactos (cubría el email).
  const boton = document.querySelector<HTMLElement>('[data-wa]');
  const portada = document.querySelector('[data-hero]');
  const pieFinal = document.querySelector('.pie__legal');
  const movil = window.matchMedia('(max-width: 760px)');

  if (boton) {
    let enPortada = false;
    let enPie = false;
    const actualizar = () => boton.classList.toggle('is-oculto', enPie || (enPortada && movil.matches));

    if (portada) {
      new IntersectionObserver(([e]) => {
        enPortada = e.intersectionRatio > 0.35;
        actualizar();
      }, { threshold: [0, 0.35, 1] }).observe(portada);
    }
    if (pieFinal) {
      new IntersectionObserver(([e]) => {
        enPie = e.isIntersecting;
        actualizar();
      }).observe(pieFinal);
    }
    movil.addEventListener('change', actualizar);
  }
</script>

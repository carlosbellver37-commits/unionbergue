---
/**
 * Fachada ilustrada intacta + sombras de objetos del escaparate
 * (herramientas/capas_fachada.py). El ratón actúa como una luz puntual:
 * cada sombra se aleja del cursor desde su objeto. La fachada no se mueve.
 */
import fachada from '../data/fachada.json';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

type Caja = { left: number; top: number; width: number; height: number; prof?: number };
const caja = (c: Caja) => `left:${c.left}%;top:${c.top}%;width:${c.width}%;height:${c.height}%`;
---

<figure class:list={['fachada', className]} style={`aspect-ratio:${fachada.w}/${fachada.h}`} data-fachada>
  <img
    class="fachada__base"
    src="/img/portada/capas/base.webp"
    srcset="/img/portada/capas/base-1000.webp 1000w, /img/portada/capas/base.webp 1605w"
    sizes="(max-width: 760px) 150vw, 72vw"
    alt="Ilustración de la fachada de Bergue: panadería, pastelería y cafetería"
    width={fachada.w}
    height={fachada.h}
    fetchpriority="high"
  />
  {Object.values(fachada.ventanas).map((v) => (
    <span class="fachada__escaparate" style={caja(v)} aria-hidden="true">
      {Object.entries(v.sombras).map(([id, c]) => (
        <img class="fachada__sombra" src={`/img/portada/capas/sombra-${id}.png`} alt="" style={caja(c)} data-sombra={c.prof} />
      ))}
    </span>
  ))}
  <slot />
</figure>

<style>
  .fachada { position: relative; margin: 0; }
  .fachada__base { width: 100%; height: 100%; }
  /* Las sombras quedan dentro de su escaparate */
  .fachada__escaparate { position: absolute; overflow: hidden; pointer-events: none; mix-blend-mode: multiply; }
  /* Luz por defecto arriba a la izquierda */
  .fachada__sombra {
    position: absolute;
    pointer-events: none;
    opacity: 0.5;
    transform: translate(10px, 14px);
    will-change: transform;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { seguirPuntero } from '../scripts/puntero';
  import { posicionEnDocumento } from '../scripts/geometria';

  gsap.registerPlugin(ScrollTrigger);

  const ALCANCE = 0.12; // px de sombra por px de distancia
  const MAXIMO = 46; // desplazamiento máximo (px) antes de la profundidad

  document.querySelectorAll<HTMLElement>('[data-fachada]').forEach((figura) => {
    const sombras = [...figura.querySelectorAll<HTMLElement>('[data-sombra]')].map((el) => ({
      el,
      prof: Number(el.dataset.sombra),
      cx: 0, // centro en el documento, sin la transformación (se mide al cambiar de tamaño)
      cy: 0,
      x: gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' }),
      y: gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' }),
    }));

    const medir = () => sombras.forEach((s) => {
      const p = posicionEnDocumento(s.el);
      s.cx = p.x + p.w / 2;
      s.cy = p.y + p.h / 2;
    });
    medir();
    new ResizeObserver(medir).observe(figura);
    // Cambios de altura por encima (p. ej. abrir un sector de "Qué hacemos") lanzan un refresh
    ScrollTrigger.addEventListener('refresh', medir);

    // Solo reaccionan al ratón, así que no dependen de "reducir movimiento".
    seguirPuntero(figura, (x, y) => {
      const scroll = window.scrollY;
      sombras.forEach((s) => {
        const dx = s.cx - x;
        const dy = s.cy - scroll - y;
        const dist = Math.hypot(dx, dy) || 1;
        const mag = Math.min(dist * ALCANCE, MAXIMO) * s.prof;
        s.x((dx / dist) * mag);
        s.y((dy / dist) * mag);
      });
    });
  });
</script>

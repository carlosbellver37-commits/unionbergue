---
/**
 * Cabecera de "Conócenos": título, fachada con sombras a la izquierda,
 * introducción a la derecha y la tienda y el horario en recuadros abiertos debajo.
 */
import TituloMarca from './ui/TituloMarca.astro';
import Fachada from './Fachada.astro';
import LineaGuia from './ui/LineaGuia.astro';
import { tiendas, horario } from '../data/site';

interface Props {
  /** En la portada va como sección (h2); en su página, como cabecera (h1). */
  nivel?: 'h1' | 'h2';
}
const { nivel = 'h1' } = Astro.props;
const Sub = nivel === 'h1' ? 'h2' : 'h3';
---

<section class="conocenos" id="conocenos" aria-labelledby="conocenos-titulo">
  <LineaGuia variante="conocenos-arriba" />
  <LineaGuia variante="conocenos" />
  <TituloMarca texto="Conócenos" id="conocenos-titulo" class="conocenos__titulo" nivel={nivel} />

  <div class="conocenos__escena">
    <Fachada class="conocenos__fachada" />
    <p class="conocenos__intro" data-reveal>
      Bergue es una empresa familiar. Llevamos más de tres décadas en la hostelería y hemos
      llevado todo lo aprendido a nuestra tienda de Las Tablas.
    </p>
  </div>

  <ul class="conocenos__tiendas" id="tiendas" aria-label="Nuestra tienda">
    {tiendas.map((t, i) => (
      <li class="tienda-card" id={t.id} style={`--retraso:${i * 0.25}s`} data-trazar>
        <Sub class="tienda-card__nombre">{t.nombre}</Sub>
        <p class="tienda-card__dir">{t.direccion}<br />{t.cp}<br /><span class="tienda-card__acceso">{t.acceso}</span></p>
        <p class="tienda-card__acceso">{t.metro.join(' · ')} · Bus {t.autobuses.join(', ')}</p>
        <p class="tienda-card__acciones">
          <a href={`tel:${t.telefonoHref}`}>{t.telefono}</a>
          <a href={t.mapa} target="_blank" rel="noopener">Cómo llegar →</a>
        </p>
      </li>
    ))}
    <li class="tienda-card tienda-card--horario" style={`--retraso:${tiendas.length * 0.25}s`} data-trazar>
      <Sub class="tienda-card__nombre">Horario</Sub>
      <p class="tienda-card__dir">{horario.general}<br /><span class="tienda-card__acceso">{horario.nota}</span></p>
      <p class="tienda-card__agosto">Agosto</p>
      <ul class="tienda-card__lista">
        {horario.agosto.map((a) => <li><span>{a.periodo}</span> {a.horas}</li>)}
      </ul>
    </li>
  </ul>
</section>

<style>
  .conocenos {
    position: relative;
    --terracota: #964b36;
    background: #f4eee0;
    color: var(--terracota);
    padding: clamp(2rem, 4vw, 3.5rem) 0 var(--space-section);
    overflow: hidden;
  }
  .conocenos :global(.conocenos__titulo) { margin-left: var(--gutter); }

  /* Fachada pegada a la izquierda e introducción a la derecha */
  .conocenos__escena {
    display: grid;
    grid-template-columns: minmax(0, 72vw) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3.5rem);
    margin-top: clamp(1rem, 4svh, 3rem);
    padding-right: var(--gutter);
  }
  .conocenos__intro {
    max-width: 22rem;
    font-family: 'Fraunces Variable', serif;
    font-weight: 400;
    font-variation-settings: 'opsz' 24, 'SOFT' 50;
    font-size: clamp(1.1rem, 0.8rem + 0.7vw, 1.5rem);
    line-height: 1.45;
    color: #3a2418;
  }

  /* Recuadros sin cerrar: falta un tramo del borde en la esquina superior derecha */
  .conocenos__tiendas {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: clamp(2.5rem, 6svh, 4.5rem) var(--gutter) 0;
    padding: 0;
  }
  /* Los cuatro tramos del recuadro abierto se dibujan al aparecer:
     izquierda (baja) → abajo (avanza) → derecha (sube) → arriba (avanza) */
  @property --izq { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  @property --abajo { syntax: '<percentage>'; inherits: false; initial-value: 100%; }
  .tienda-card {
    position: relative;
    display: grid;
    gap: 0.6rem;
    padding: 1.8rem 2rem 1.6rem;
    background:
      linear-gradient(currentColor, currentColor) left top / 1.5px var(--izq) no-repeat,
      linear-gradient(currentColor, currentColor) left bottom / var(--abajo) 1.5px no-repeat,
      #f4eee0;
    transition: transform 500ms var(--ease-out), box-shadow 500ms var(--ease-out);
  }
  .tienda-card::before { transition: width 0.7s cubic-bezier(0.65, 0, 0.35, 1) 1.5s; }
  .tienda-card::after { transition: height 0.5s cubic-bezier(0.65, 0, 0.35, 1) 1.05s; }
  :global(.motion) .tienda-card:not(.is-trazada) { --izq: 0%; --abajo: 0%; }
  :global(.motion) .tienda-card:not(.is-trazada)::before { width: 0; }
  :global(.motion) .tienda-card:not(.is-trazada)::after { height: 0; }
  .tienda-card.is-trazada {
    transition:
      --izq 0.5s cubic-bezier(0.65, 0, 0.35, 1) var(--retraso, 0s),
      --abajo 0.6s cubic-bezier(0.65, 0, 0.35, 1) calc(var(--retraso, 0s) + 0.45s),
      transform 500ms var(--ease-out),
      box-shadow 500ms var(--ease-out);
  }
  .tienda-card.is-trazada::before { transition-delay: calc(var(--retraso, 0s) + 1.5s); }
  .tienda-card.is-trazada::after { transition-delay: calc(var(--retraso, 0s) + 1.05s); }
  /* Tramo superior que no llega a la esquina, y lateral derecho que no llega arriba */
  .tienda-card::before,
  .tienda-card::after { content: ''; position: absolute; background: currentColor; }
  .tienda-card::before { top: 0; left: 0; width: 62%; height: 1.5px; }
  .tienda-card::after { right: 0; bottom: 0; width: 1.5px; height: 58%; }

  .tienda-card:hover,
  .tienda-card:focus-within {
    transform: translateY(-10px) rotate(-0.6deg);
    box-shadow: 0 22px 30px -18px rgb(80 40 25 / 0.45);
  }

  .tienda-card__nombre {
    font-family: 'Fraunces Variable', serif;
    font-weight: 900;
    font-variation-settings: 'opsz' 144, 'SOFT' 0, 'WONK' 1;
    font-size: clamp(1.8rem, 1.2rem + 2vw, 3rem);
    letter-spacing: -0.03em;
  }
  .tienda-card__dir { color: #3a2418; }
  .tienda-card__acceso { font-size: var(--text-sm); opacity: 0.85; }
  .tienda-card__agosto { margin-top: 0.4rem; font-size: var(--text-xs); letter-spacing: 0.2em; text-transform: uppercase; }
  .tienda-card__lista { list-style: none; padding: 0; display: grid; gap: 0.2rem; color: #3a241c; font-size: var(--text-sm); }
  .tienda-card__lista span { color: #964b36; margin-right: 0.4rem; }
  .tienda-card__acciones { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-top: 0.4rem; font-size: var(--text-sm); }
  .tienda-card__acciones a { color: inherit; text-decoration: none; border-bottom: 1px solid currentColor; }
  .tienda-card__acciones a:hover { color: #3a2418; }

  @media (max-width: 760px) {
    .conocenos__escena { grid-template-columns: 100%; padding-right: 0; }
    .conocenos :global(.conocenos__fachada) { width: 150vw; }
    .conocenos__intro { margin: 0 var(--gutter); }
    .conocenos__tiendas { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Los recuadros se trazan al entrar en pantalla
  const tarjetas = document.querySelectorAll<HTMLElement>('[data-trazar]');
  const obs = new IntersectionObserver((entradas) => {
    entradas.forEach((e) => {
      if (!e.isIntersecting) return;
      e.target.classList.add('is-trazada');
      obs.unobserve(e.target);
    });
  }, { threshold: 0.35 });
  tarjetas.forEach((t) => obs.observe(t));
</script>

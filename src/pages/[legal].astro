---
import Base from '../layouts/Base.astro';
import AvisoLegal from '../components/legal/AvisoLegal.astro';
import Privacidad from '../components/legal/Privacidad.astro';
import Cookies from '../components/legal/Cookies.astro';
import { site, tiendas } from '../data/site';

// Textos de la web original, tal cual los tenía el cliente (ver cada componente)
export function getStaticPaths() {
  return [
    { params: { legal: 'aviso-legal' }, props: { titulo: 'Aviso legal', Texto: AvisoLegal } },
    { params: { legal: 'privacidad' }, props: { titulo: 'Política de privacidad', Texto: Privacidad } },
    { params: { legal: 'cookies' }, props: { titulo: 'Política de cookies', Texto: Cookies } },
  ];
}

const { titulo, Texto } = Astro.props;
const { razonesSociales, cif, domicilio } = site.legal;
---

<Base title={titulo}>
  <article class="legal wrap">
    <p class="eyebrow">Información legal</p>
    <h1>{titulo}</h1>

    <Texto />

    <h2>Datos del titular</h2>
    <ul>
      <li>Razón social: {razonesSociales.join(' / ')}</li>
      <li>CIF: {cif}</li>
      <li>Domicilio: {domicilio}</li>
      <li>Teléfono: {tiendas[0].telefono}</li>
      <li>Email: <a href={`mailto:${site.email}`}>{site.email}</a></li>
    </ul>
  </article>
</Base>

<style>
  .legal { max-width: 52rem; padding-top: 9rem; padding-bottom: var(--space-section); display: grid; gap: 1.2rem; }
  .legal h1 { font-size: var(--text-2xl); margin-bottom: 1rem; }
  .legal h2 { font-size: var(--text-lg); margin-top: 1.5rem; }
  /* :global: el texto viene de los componentes de components/legal */
  .legal :global(p), .legal :global(li) { color: var(--tostado); }
  .legal :global(ul) { padding-left: 1.2rem; display: grid; gap: 0.3rem; }
  .legal :global(strong) { color: var(--corteza); }
  .legal :global(a) { color: var(--corteza); }
</style>

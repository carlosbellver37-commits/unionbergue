---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="no-encontrada wrap">
    <p class="eyebrow">Error 404</p>
    <h1>Esta bandeja<br /><em>está vacía</em></h1>
    <p>La página que buscas no existe o ha cambiado de sitio.</p>
    <a class="btn-oval" href="/">Volver al inicio</a>
  </section>
</Base>

<style>
  .no-encontrada { min-height: 80svh; display: grid; align-content: center; justify-items: start; gap: 1.5rem; padding-block: 8rem 4rem; }
  .no-encontrada h1 { font-size: var(--text-2xl); }
  .no-encontrada h1 em { color: var(--caramelo); }
  .no-encontrada p:not(.eyebrow) { color: var(--tostado); }
</style>
